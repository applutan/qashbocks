# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
.eggs/

# Virtual environments
.venv/
env/
venv/

# Local configuration overrides (preserve config.example.toml)
config.toml

# Private databases (preserve data/sample.db)
data/*.db
!data/sample.db

# User reports & temporary exports
reports/
*.tmp
*.log
